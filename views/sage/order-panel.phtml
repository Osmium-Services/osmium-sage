<div class="card mb-4">
    <div class="card-header"><h5 class="mb-0">Sage</h5></div>
    <div class="card-body">
        <?php if ($sage['synced']) : ?>
            <p class="mb-1"><span class="badge bg-success">Pushed to Sage</span></p>
            <p class="small text-muted mb-0">
                <?= $sage['invoiceNumber'] ? 'Invoice ' . \htmlspecialchars((string) $sage['invoiceNumber']) . ', synced ' : 'Synced ' ?>
                <?= \htmlspecialchars((string) $sage['syncedAt']) ?>
            </p>
        <?php elseif ($sage['canPush']) : ?>
            <button type="button" class="btn btn-outline-primary btn-sm w-100" id="pushToSageBtn">Push to Sage</button>
            <p class="small text-muted mt-2 mb-0">Creates a posted sales invoice in Sage. This cannot be undone from here.</p>
        <?php else : ?>
            <p class="small text-muted mb-0">Only a paid order can be pushed to Sage.</p>
        <?php endif; ?>
    </div>
</div>
<?php if ($sage['canPush']) : ?>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var btn = document.getElementById('pushToSageBtn');
    if (!btn || !window.osmiumOrder) return;

    btn.addEventListener('click', function () {
        btn.disabled = true;
        window.osmiumOrder.post({ action: 'push_to_sage' }).then(function (data) {
            if (!data.success) {
                window.osmiumOrder.feedback(data.error || 'Could not push to Sage', true);
                btn.disabled = false;
                return;
            }
            window.osmiumOrder.returnToOrder();
        });
    });
});
</script>
<?php endif; ?>
